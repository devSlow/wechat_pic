.page {
  min-height: 100vh;
  background: var(--bg);
}

/* ===== Header ===== */
.mode-header {
  padding: 32rpx 28rpx 16rpx;
}

.mode-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  display: block;
}

.mode-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  display: block;
}

/* ===== Tabs ===== */
.mode-tabs {
  display: flex;
  gap: 8rpx;
  margin: 0 20rpx 16rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 8rpx;
  color: var(--text-secondary);
  background: var(--bg);
  transition: all 0.1s;
}

.mode-tab.active {
  background: var(--primary);
  color: #fff;
}

/* ===== Card ===== */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  margin: 0 20rpx 16rpx;
  padding: 24rpx 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.03);
}

.card-title {
  font-size: 26rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
  color: var(--text);
}

/* ===== Upload Zone ===== */
.upload-zone {
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-md);
  padding: 100rpx 32rpx;
  text-align: center;
  background: var(--bg);
  transition: all 0.15s;
}

.upload-zone:active {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.upload-icon {
  font-size: 48rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 8rpx;
}

.upload-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
}

/* ===== Compress Grid ===== */
.compress-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.compress-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--bg);
}

.compress-img {
  width: 100%;
  height: 100%;
}

.compress-size {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 4rpx;
}

.compress-remove {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  background: #EF4444;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  z-index: 1;
}

.compress-result-badge {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  background: rgba(37,99,235,0.8);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 4rpx;
}

.compress-add {
  aspect-ratio: 1;
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: var(--bg);
  transition: all 0.15s;
}

.compress-add:active {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.add-icon {
  font-size: 40rpx;
  color: var(--text-tertiary);
}

.add-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.compress-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 8rpx 16rpx;
}

.clear-btn:active {
  color: #EF4444;
}

/* ===== Compress Result ===== */
.result-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.result-header-row .card-title {
  margin-bottom: 0;
}

.reset-btn {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}

.reset-btn:active {
  opacity: 0.7;
}

.compress-result-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.compress-result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  background: var(--bg);
  border-radius: var(--radius-sm);
}

.result-info-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
}

.result-original {
  color: var(--text-secondary);
}

.result-arrow {
  color: var(--text-tertiary);
}

.result-compressed {
  color: var(--primary);
  font-weight: 600;
}

.result-rate {
  color: var(--text-secondary);
}

.result-save-btn {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
  padding: 8rpx 16rpx;
}

.result-save-btn:active {
  opacity: 0.7;
}

/* ===== Preview ===== */
.preview-box {
  position: relative;
}

.preview-img {
  width: 100%;
  border-radius: var(--radius-sm);
}

.preview-info {
  margin-top: 12rpx;
  padding: 12rpx;
  background: var(--bg);
  border-radius: var(--radius-sm);
}

.preview-size {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.preview-change {
  text-align: center;
  padding: 14rpx;
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
  margin-top: 12rpx;
}

.preview-change:active { opacity: 0.6; }

/* ===== KB Options ===== */
.kb-options {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.kb-option {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  background: var(--card-bg);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text);
  transition: all 0.15s;
}

.kb-option:active {
  opacity: 0.7;
}

.kb-option.active {
  background: var(--primary-bg);
  border-color: var(--primary);
  color: var(--primary);
}

.compress-action {
  margin-top: 24rpx;
}

/* ===== Compress Result ===== */
.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-header .card-title {
  margin-bottom: 0;
}

.reset-btn {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
  padding: 8rpx 16rpx;
}

.reset-btn:active {
  opacity: 0.7;
}

.result-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.summary-item {
  text-align: center;
  padding: 16rpx;
  background: var(--bg);
  border-radius: var(--radius-sm);
}

.summary-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 4rpx;
}

.summary-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  display: block;
}

.summary-value.highlight {
  color: var(--primary);
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 16rpx;
  background: var(--bg);
  border-radius: var(--radius-sm);
}

.result-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
}

.result-from {
  color: var(--text-secondary);
}

.result-arrow {
  color: var(--text-tertiary);
}

.result-to {
  color: var(--primary);
  font-weight: 600;
}

.result-skip {
  color: var(--text-tertiary);
  font-weight: 400;
}

.result-rate {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.result-actions {
  margin-top: 8rpx;
}

.kb-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background: var(--bg);
  border: 1.5rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
  text-align: center;
}

.kb-input:focus {
  border-color: var(--primary);
}

.kb-unit {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

/* ===== Quality Presets ===== */
.quality-presets {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.quality-chip {
  flex: 1;
  text-align: center;
  padding: 14rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.1s;
}

.quality-chip:active { transform: scale(0.96); }
.quality-chip.active { border-color: var(--primary); background: var(--primary-bg); color: var(--primary); }

/* ===== Result ===== */
.result-info {
  background: var(--bg);
  border-radius: var(--radius-sm);
  padding: 16rpx;
}

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.result-row + .result-row {
  border-top: 1rpx solid var(--border);
}

.result-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.result-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.result-value.highlight {
  color: var(--primary);
}

/* ===== Watermark Options ===== */
.watermark-image-area {
  width: 100%;
  min-height: 280rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--bg);
}

.watermark-preview-box {
  width: 100%;
  position: relative;
  display: flex;
  justify-content: center;
  background: var(--bg);
}

.watermark-preview-img {
  width: 100%;
}

.watermark-reupload {
  margin-top: 12rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-sm);
}

.watermark-reupload-text {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}

.watermark-remove {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  background: #EF4444;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  z-index: 1;
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.color-swatch {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 6rpx;
  border-radius: var(--radius-sm);
  background: var(--bg);
  border: 2rpx solid transparent;
}

.color-swatch.active {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.color-fill {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
}

.color-swatch.active .color-fill {
  box-shadow: 0 0 0 3rpx var(--primary), 0 2rpx 6rpx rgba(0,0,0,0.1);
}

.color-label {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.color-swatch.active .color-label {
  color: var(--primary);
  font-weight: 500;
}

.slider-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.slider-item {
  display: flex;
  align-items: center;
}

.slider-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  width: 120rpx;
  flex-shrink: 0;
}

.slider-control {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.slider-control slider {
  flex: 1;
}

.slider-value {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
  min-width: 52rpx;
  text-align: right;
}

.watermark-opts {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.watermark-opt {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.opt-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}
/* ===== Format Options ===== */
.format-options {
  display: flex;
  gap: 12rpx;
}

.format-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  background: var(--bg);
  border: 1.5rpx solid var(--border);
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
  transition: all 0.15s;
}

.format-btn:active {
  opacity: 0.7;
}

.format-btn.active {
  background: var(--primary-bg);
  border-color: var(--primary);
  color: var(--primary);
}

.convert-format-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  padding: 2rpx;
}

/* ===== Action Bar ===== */
.action-bar {
  margin: 8rpx 20rpx 0;
}

.btn-primary {
  display: block;
  width: 100%;
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: var(--radius-sm);
  padding: 24rpx 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.1s;
}

.btn-primary:active { opacity: 0.85; }

/* ===== Form Input ===== */
.form-input {
  width: 100%;
  padding: 20rpx 22rpx;
  background: var(--bg);
  border: 1.5rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  color: var(--text);
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--primary);
}
