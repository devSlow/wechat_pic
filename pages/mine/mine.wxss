.page {
  min-height: 100vh;
  background: var(--bg);
}

/* ===== Header ===== */
.about-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 28rpx 40rpx;
  background: var(--card-bg);
  margin-bottom: 20rpx;
}

.app-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.app-icon-img {
  width: 100%;
  height: 100%;
}

.app-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
}

.version-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.app-version {
  font-size: 24rpx;
  color: var(--text-tertiary);
  background: var(--bg);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* ===== Section Group ===== */
.section-group {
  margin-bottom: 20rpx;
}

/* ===== Menu Card ===== */
.menu-card {
  background: var(--card-bg);
  margin: 0 20rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.03);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}

.menu-item:active {
  background: var(--bg);
}

.menu-divider {
  height: 1rpx;
  background: var(--border);
  margin: 0 24rpx 0 84rpx;
}

.menu-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon.blue { background: #EFF6FF; }
.menu-icon.orange { background: #FFF7ED; }
.menu-icon.green { background: #F0FDF4; }
.menu-icon.purple { background: #F5F3FF; }
.menu-icon.pink { background: #FDF2F8; }
.menu-icon.teal { background: #F0FDFA; }
.menu-icon.amber { background: #FFFBEB; }

.icon-letter {
  font-size: 24rpx;
  font-weight: 700;
}

.menu-icon.blue .icon-letter { color: #3B82F6; }
.menu-icon.orange .icon-letter { color: #F97316; }
.menu-icon.green .icon-letter { color: #22C55E; }
.menu-icon.purple .icon-letter { color: #8B5CF6; }
.menu-icon.pink .icon-letter { color: #EC4899; }
.menu-icon.teal .icon-letter { color: #14B8A6; }
.menu-icon.amber .icon-letter { color: #F59E0B; }

.menu-body {
  flex: 1;
  min-width: 0;
}

.menu-btn {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  text-align: left;
  line-height: inherit;
  font-size: inherit;
  display: flex;
  align-items: center;
}

.menu-btn::after {
  border: none;
}

.menu-item-inner {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  display: block;
}

.menu-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
}

/* ===== Footer ===== */
.footer {
  text-align: center;
  padding: 48rpx 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.footer-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.footer-link {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.footer-link:active {
  color: var(--primary);
}

.footer-divider {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.footer-copyright {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.footer-made {
  font-size: 22rpx;
  color: var(--text-tertiary);
}
