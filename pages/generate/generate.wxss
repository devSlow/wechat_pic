.page {
  min-height: 100vh;
  background: #F8F9FA;
}

.page-scroll {
  min-height: 100vh;
}

/* ===== Tab Bar ===== */
.tab-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 20rpx 20rpx 0;
  background: #F8F9FA;
}

.tab-item {
  padding: 12rpx 0;
  position: relative;
}

.tab-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #9CA3AF;
}

.tab-item.active .tab-label {
  color: #171717;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  border-radius: 2rpx;
  background: #171717;
}

/* ===== Prompt Area ===== */
.prompt-area {
  margin: 20rpx 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 24rpx;
  overflow: hidden;
}

.prompt-input {
  width: 100%;
  min-height: 180rpx;
  font-size: 28rpx;
  color: #404040;
  line-height: 48rpx;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.prompt-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 16rpx 16rpx 20rpx;
  border-top: 1rpx solid #F3F4F6;
}

.prompt-tools {
  display: flex;
  gap: 16rpx;
}

.prompt-tool-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.tool-icon-text {
  font-size: 22rpx;
  color: #9CA3AF;
  font-weight: 300;
}

.tool-label {
  font-size: 22rpx;
  color: #9CA3AF;
}

.generate-btn {
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  background: #171717;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  line-height: 1;
}

.generate-btn:active {
  background: #404040;
}

.generate-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* ===== Options ===== */
.options-section {
  padding: 0 16rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.option-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #737373;
  padding: 0 8rpx;
}

.grid-4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.grid-5 {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
}

.chip {
  padding: 18rpx 0;
  border-radius: 14rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  font-size: 24rpx;
  color: #404040;
  font-weight: 500;
  text-align: center;
}

.chip:active {
  opacity: 0.7;
}

.chip.active {
  background: #171717;
  border-color: #171717;
  color: #FFFFFF;
}

.neg-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  font-size: 26rpx;
  color: #404040;
  box-sizing: border-box;
}

.slider-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.slider-val {
  font-size: 24rpx;
  color: #171717;
  font-weight: 600;
}

.app-slider {
  width: 100%;
  margin-top: 8rpx;
}

.slider-labels {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

/* ===== Results ===== */
.section-group {
  margin-top: 32rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 16rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #171717;
}

.result-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 0 16rpx;
}

.result-item {
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  aspect-ratio: 1;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
}

.result-img {
  width: 100%;
  height: 100%;
  display: block;
}

.result-save {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(23, 23, 23, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-icon {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ===== Library ===== */
.library-header {
  padding: 20rpx 16rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #F3F4F6;
}

.search-icon {
  font-size: 32rpx;
  color: #9CA3AF;
  flex-shrink: 0;
  line-height: 1;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #171717;
  background: transparent;
  border: none;
  outline: none;
  min-width: 0;
}

.category-scroll {
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

.category-scroll::-webkit-scrollbar {
  display: none;
}

.category-track {
  display: flex;
  gap: 12rpx;
  padding: 0 4rpx 8rpx;
  white-space: nowrap;
}

.category-pill {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  font-size: 24rpx;
  color: #737373;
  font-weight: 500;
  flex-shrink: 0;
}

.category-pill:active {
  border-color: #D1D5DB;
}

.category-pill.active {
  background: #171717;
  border-color: #171717;
  color: #FFFFFF;
}

.library-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 0 16rpx;
}

.library-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E5E7EB;
  overflow: hidden;
}

.library-card:active {
  opacity: 0.85;
}

.library-image {
  width: 100%;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.library-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.library-glyph {
  font-size: 80rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.85);
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.library-body {
  padding: 16rpx;
}

.library-prompt {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 22rpx;
  color: #404040;
  line-height: 1.5;
}

.library-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}

.library-style {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #F3F4F6;
  font-size: 20rpx;
  color: #737373;
}

/* ===== Detail Panel ===== */
.detail-overlay {
  position: fixed;
  inset: 0;
  background: rgba(23, 23, 23, 0.45);
  opacity: 0;
  transition: opacity 0.25s;
  z-index: 100;
  pointer-events: none;
}

.detail-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.detail-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 20rpx 28rpx 48rpx;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.22, 0.8, 0.2, 1);
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}

.detail-panel.show {
  transform: translateY(0);
}

.detail-handle {
  width: 56rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #E5E7EB;
  margin: 0 auto 24rpx;
}

.detail-image {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-thumb {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 16rpx;
}

.detail-glyph {
  font-size: 120rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.85);
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.detail-style-tag {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #F3F4F6;
  font-size: 22rpx;
  color: #737373;
}

.detail-prompt-text {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #404040;
  line-height: 1.7;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.detail-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 999rpx;
  background: #F3F4F6;
  color: #404040;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  border: none;
}

.detail-btn:active {
  background: #E5E7EB;
}

.detail-btn.primary {
  background: #171717;
  color: #FFFFFF;
}

.detail-btn.primary:active {
  background: #404040;
}

.home-footer-space {
  height: 40rpx;
}
