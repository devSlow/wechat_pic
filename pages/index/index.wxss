.page {
  min-height: 100vh;
  background: var(--bg);
}

/* ===== Header ===== */
.mode-header {
  padding: 24rpx 28rpx 20rpx;
  background: var(--card-bg);
}

.mode-title {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: var(--text);
  display: block;
}

.mode-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  display: block;
}

/* ===== Section ===== */
.section {
  padding: 16rpx 20rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
  display: block;
}

/* ===== Spec List ===== */
.spec-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.spec-card {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 20rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.03);
  border: 2rpx solid transparent;
  transition: all 0.15s;
}

.spec-card:active {
  transform: scale(0.98);
}

.spec-card.active {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.spec-card-color {
  width: 8rpx;
  height: 56rpx;
  border-radius: 4rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.spec-card-body {
  flex: 1;
  min-width: 0;
}

.spec-card-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.spec-card-check {
  width: 36rpx;
  height: 36rpx;
  background: var(--primary);
  color: #FFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  font-size: 20rpx;
  color: #FFF;
}

.spec-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  display: block;
  margin-bottom: 4rpx;
}

.spec-card-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
}

.spec-card-size {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}

/* ===== More Specs ===== */
.more-specs {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx;
  background: var(--card-bg);
  border-radius: var(--radius-md);
  margin-top: 10rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.03);
}

.more-specs-text {
  font-size: 26rpx;
  color: var(--primary);
}

.more-specs-arrow {
  font-size: 28rpx;
  color: var(--primary);
  margin-left: 8rpx;
}

/* ===== Action Bar ===== */
.action-bar {
  padding: 8rpx 20rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-sm);
  padding: 22rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  transition: opacity 0.15s;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-primary.disabled {
  opacity: 0.4;
}

.btn-secondary {
  background: var(--card-bg);
  color: var(--text);
  border: 1.5rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 20rpx 44rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  transition: background 0.15s;
}

.btn-secondary:active {
  background: var(--bg);
}

.btn-secondary.disabled {
  opacity: 0.4;
}

/* ===== Loading ===== */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  gap: 24rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.loading-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== Result ===== */
.result-box {
  padding-bottom: 40rpx;
}

.result-header {
  padding: 24rpx 20rpx 16rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.result-spec {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.result-preview {
  padding: 40rpx;
  margin: 0 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-md);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.03);
}

.preview-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.preview-top-label,
.preview-bottom-label {
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-middle {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.preview-left-label,
.preview-right-label {
  width: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.label-text {
  font-size: 20rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

.preview-photo-box {
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
  border-radius: 4rpx;
  overflow: hidden;
}

.preview-image {
  display: block;
}

.layout-image {
  width: 100%;
}

.layout-canvas {
  display: block;
}

.layout-canvas.hidden {
  display: none;
}

/* ===== Color Section ===== */
.color-section {
  margin: 16rpx 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 20rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.03);
}

.color-options {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
}

.color-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx;
  border-radius: var(--radius-sm);
  transition: all 0.15s;
}

.color-item.active {
  background: var(--primary-bg);
}

.color-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.color-name {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.hd-section {
  margin: 16rpx 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 20rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.03);
}

.hd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hd-label {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

.hd-switch {
  transform: scale(0.85);
}

.layout-desc {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
}

.retake-btn {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 20rpx;
}

.retake-btn:active {
  color: var(--primary);
}

/* ===== Panel ===== */
.panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.panel-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--card-bg);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  z-index: 101;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx 20rpx;
  border-bottom: 1rpx solid var(--border);
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.panel-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 40rpx;
  color: var(--text-secondary);
}

.panel-tabs {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx 0;
}

.panel-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--bg);
  border-radius: var(--radius-sm);
  transition: all 0.15s;
}

.panel-tab.active {
  background: var(--primary);
  color: #FFF;
}

.panel-list {
  flex: 1;
  height: 60vh;
  padding: 8rpx 24rpx;
  box-sizing: border-box;
}

.spec-row {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 4rpx;
  transition: background 0.15s;
}

.spec-row:active {
  background: var(--bg);
}

.spec-row.active {
  background: var(--primary-bg);
}

.spec-row-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.spec-row-body {
  flex: 1;
}

.spec-row-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  display: block;
}

.spec-row-size {
  font-size: 22rpx;
  color: var(--primary);
  display: block;
  margin-top: 2rpx;
}

.spec-row-check {
  width: 36rpx;
  height: 36rpx;
  background: var(--primary);
  color: #FFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
