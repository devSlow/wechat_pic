.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 48rpx;
}

/* ===== Header ===== */
.mode-header {
  padding: 32rpx 28rpx 16rpx;
}

.mode-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  display: block;
}

.mode-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  display: block;
}

.mode-tabs {
  display: flex;
  gap: 8rpx;
  margin: 0 20rpx 16rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 8rpx;
  color: var(--text-secondary);
  background: var(--bg);
  transition: all 0.1s;
}

.mode-tab.active {
  background: var(--primary);
  color: #fff;
}

/* ===== Card ===== */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  margin: 0 20rpx 16rpx;
  padding: 24rpx 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.03);
}

.card-title {
  font-size: 26rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
  color: var(--text);
}

/* ===== Direction ===== */
.dir-row {
  display: flex;
  gap: 14rpx;
}

.dir-chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 20rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.1s;
}

.dir-chip:active { transform: scale(0.97); }
.dir-chip.active { border-color: var(--primary); background: var(--primary-bg); }

.dir-icon {
  width: 56rpx;
  height: 64rpx;
  display: grid;
  gap: 3rpx;
}

.dir-icon.vertical {
  grid-template-columns: 1fr;
  grid-template-rows: 1fr 1fr 1fr;
}

.dir-icon.horizontal {
  grid-template-columns: 1fr 1fr 1fr;
  grid-template-rows: 1fr;
}

.dir-cell {
  background: var(--text-tertiary);
  border-radius: 2rpx;
}

.dir-chip.active .dir-cell {
  background: var(--primary);
}

.dir-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
  margin-top: 8rpx;
}

.dir-chip.active .dir-label {
  color: var(--primary);
}

/* ===== Stitch ===== */
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.image-grid-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.image-grid-img {
  width: 100%;
  height: 100%;
}

.image-grid-remove {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  background: #EF4444;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  z-index: 1;
}

.image-grid-add {
  aspect-ratio: 1;
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}

.image-grid-add:active {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.image-grid-add-icon {
  font-size: 48rpx;
  color: var(--text-tertiary);
}

/* ===== Settings ===== */
.compact-card {
  padding: 0;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.setting-label {
  font-size: 28rpx;
  color: var(--text);
}

.setting-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.setting-arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.setting-divider {
  height: 1rpx;
  background: var(--border);
  margin: 0 24rpx;
}


.slot-scroll {
  max-height: 620rpx;
}

.slot-list-v {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.slot-item {
  width: 100%;
  flex-shrink: 0;
  display: flex;
  justify-content: center;
}

.slot-scroll-h {
  overflow-x: auto;
}

.slot-list-h {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  padding: 4rpx 0;
}

.slot-item-h {
  flex-shrink: 0;
}

.slot-filled {
  position: relative;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot-filled.vertical {
  width: 100%;
  height: 280rpx;
}

.slot-filled.horizontal {
  width: 280rpx;
  height: 280rpx;
}

.slot-img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.slot-remove {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 36rpx;
  height: 36rpx;
  background: #EF4444;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
}

.slot-empty {
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  transition: all 0.1s;
}

.slot-empty.vertical {
  width: 100%;
  height: 280rpx;
}

.slot-filled.vertical {
  width: 100%;
  height: 280rpx;
}

.slot-empty.horizontal {
  width: 280rpx;
  height: 280rpx;
}

.slot-empty:active {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.slot-plus {
  font-size: 48rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}

.slot-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.add-btn-area {
  margin-top: 16rpx;
  padding: 20rpx;
  text-align: center;
  background: var(--bg);
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-md);
}

.add-btn-area:active {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.add-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--primary);
}

.slot-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== Preview ===== */
.upload-zone {
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-md);
  padding: 60rpx 32rpx;
  text-align: center;
  background: var(--bg);
  transition: all 0.15s;
}

.upload-zone:active {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.upload-icon {
  font-size: 48rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 8rpx;
}

.upload-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
}

.preview-box {
  position: relative;
}

.preview-img {
  width: 100%;
  border-radius: var(--radius-sm);
}

.preview-change {
  text-align: center;
  padding: 14rpx;
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
  margin-top: 12rpx;
}

.preview-change:active { opacity: 0.6; }

/* ===== Collage ===== */
.collage-opts {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
}

.collage-opt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 8rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  transition: all 0.1s;
}

.collage-opt:active { transform: scale(0.96); }
.collage-opt.active { border-color: var(--primary); background: var(--primary-bg); }

.layout-icon {
  width: 56rpx;
  height: 64rpx;
  display: grid;
  gap: 3rpx;
}

.layout-cell {
  background: var(--text-tertiary);
  border-radius: 2rpx;
}

.collage-opt.active .layout-cell {
  background: var(--primary);
}

.layout-icon.grid-2x1 {
  grid-template-columns: 1fr;
  grid-template-rows: 1fr 1fr;
}

.layout-icon.grid-3x1 {
  grid-template-columns: 1fr;
  grid-template-rows: 1fr 1fr 1fr;
}

.layout-icon.grid-2x2 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
}

.layout-icon.grid-3x2 {
  grid-template-columns: 1fr 1fr 1fr;
  grid-template-rows: 1fr 1fr;
}

.layout-icon.grid-3x3 {
  grid-template-columns: 1fr 1fr 1fr;
  grid-template-rows: 1fr 1fr 1fr;
}

.layout-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.collage-opt.active .layout-label {
  color: var(--primary);
}

.collage-grid {
  display: grid;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.collage-cell {
  aspect-ratio: 1;
  min-width: 0;
  overflow: hidden;
}

.collage-filled {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.collage-img {
  width: 100%;
  height: 100%;
}

.collage-remove {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 36rpx;
  height: 36rpx;
  background: #EF4444;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
}

.collage-empty {
  width: 100%;
  height: 100%;
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  transition: all 0.1s;
  box-sizing: border-box;
}

.collage-empty:active {
  border-color: var(--primary);
  background: var(--primary-bg);
}

/* ===== Grid Options ===== */
/* ===== Action Bar ===== */
.action-bar {
  margin: 8rpx 20rpx 0;
}

.btn-primary {
  display: block;
  width: 100%;
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: var(--radius-sm);
  padding: 24rpx 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.1s;
}

.btn-primary:active { opacity: 0.85; }
.btn-primary.disabled { opacity: 0.4; }

/* ===== Result ===== */
.result-card {
  margin-top: 10rpx;
}

.result-card.anim-pop {
  animation: cardPop 0.35s ease;
}

@keyframes cardPop {
  0% { transform: scale(0.97); opacity: 0.5; }
  50% { transform: scale(1.01); }
  100% { transform: scale(1); opacity: 1; }
}

.result-strip {
  white-space: nowrap;
  padding: 4rpx 0;
}

.result-cell {
  display: inline-block;
  width: 160rpx;
  height: 160rpx;
  margin-right: 14rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  position: relative;
}

.result-img {
  width: 100%;
  height: 100%;
}

.result-label {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 6rpx;
}

/* ===== Retake link ===== */
.result-foot {
  text-align: center;
  padding: 12rpx 0 32rpx;
}

.result-foot-link {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 16rpx 32rpx;
}

.result-foot-link:active { opacity: 0.6; }

.grid9-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4rpx;
  background: var(--border);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.grid9-cell {
  aspect-ratio: 1;
  overflow: hidden;
}

.grid9-cell:active {
  opacity: 0.8;
}

.grid9-img {
  width: 100%;
  height: 100%;
  display: block;
}



