.info-bar {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
}

.info-chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 10rpx;
  background: var(--bg);
  border-radius: var(--radius-sm);
}

.info-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.info-val {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.preview-image {
  width: 100%;
  border-radius: var(--radius-sm);
}
