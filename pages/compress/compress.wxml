<view class="page">
  <view class="card" style="margin-top: 16rpx;">
    <text class="section-title">图片</text>
    <view class="upload-area" wx:if="{{!sourceImage}}" bindtap="chooseImage">
      <image class="icon-svg lg" src="{{iconUpload}}" mode="aspectFit" style="margin:0 auto;" />
      <text class="upload-text">选择图片</text>
    </view>
    <image src="{{sourceImage}}" mode="aspectFit" class="preview-image" wx:else />

    <view class="info-bar" wx:if="{{sourceImage}}">
      <view class="info-chip">
        <text class="info-label">原始</text>
        <text class="info-val">{{originalSize}}</text>
      </view>
      <view class="info-chip" wx:if="{{resultSize}}">
        <text class="info-label">压缩后</text>
        <text class="info-val" style="color:var(--success);">{{resultSize}}</text>
      </view>
      <view class="info-chip" wx:if="{{compressScale}}">
        <text class="info-label">压缩率</text>
        <text class="info-val" style="color:var(--primary);">{{compressScale}}</text>
      </view>
    </view>
  </view>

  <block wx:if="{{sourceImage}}">
    <view class="card">
      <text class="section-title">参数</text>
      <view class="form-item">
        <view class="slider-header">
          <text class="form-label">质量</text>
          <text class="slider-value">{{quality}}%</text>
        </view>
        <slider min="1" max="100" step="1" value="{{quality}}" bindchanging="onQualityChanging" bindchange="onQualityChange" block-size="16" />
        <view style="display:flex;justify-content:space-between;font-size:20rpx;color:var(--text-tertiary);margin-top:-6rpx;">
          <text>小体积</text>
          <text>高质量</text>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">格式</text>
        <picker mode="selector" range="{{formats}}" value="{{formatIndex}}" bindchange="onFormatChange">
          <view class="form-picker">{{formats[formatIndex]}}</view>
        </picker>
      </view>
    </view>

    <view class="action-bar">
      <button class="btn-primary" bindtap="doCompress">开始压缩</button>
    </view>

    <view class="card" wx:if="{{resultImage}}">
      <text class="section-title">结果</text>
      <image src="{{resultImage}}" mode="aspectFit" class="preview-image" />
      <view style="margin-top:20rpx;">
        <button class="btn-primary" bindtap="saveResult">保存</button>
        <button class="btn-secondary" bindtap="reset" style="margin-top:14rpx;">重新选择</button>
      </view>
    </view>
  </block>
</view>
