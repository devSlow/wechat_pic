page {
  --primary: #2563EB;
  --primary-bg: #EFF6FF;
  --success: #22C55E;
  --warning: #F59E0B;
  --danger: #EF4444;
  --bg: #F8FAFC;
  --card-bg: #FFFFFF;
  --text: #0F172A;
  --text-secondary: #64748B;
  --text-tertiary: #CBD5E1;
  --border: #F1F5F9;
  --radius-sm: 10rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;

  box-sizing: border-box;
  background-color: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, scroll-view, swiper, movable-view, text, image, button, input, picker, slider, checkbox {
  box-sizing: border-box;
}

image {
  display: block;
}

/* ===== Typography ===== */
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: var(--text);
  padding: 48rpx 28rpx 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 0 28rpx 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* ===== Cards ===== */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin: 12rpx 20rpx;
}

/* ===== Buttons ===== */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-sm);
  padding: 26rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  transition: opacity 0.15s;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-primary.disabled {
  opacity: 0.4;
}

.btn-secondary {
  background: var(--card-bg);
  color: var(--text);
  border: 1.5rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 24rpx 44rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  transition: background 0.15s;
}

.btn-secondary:active {
  background: var(--bg);
}

/* ===== Form Elements ===== */
.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx 22rpx;
  background: var(--bg);
  border: 1.5rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  color: var(--text);
}

.form-input:focus {
  border-color: var(--primary);
  outline: none;
}

.form-picker {
  padding: 20rpx 22rpx;
  background: var(--bg);
  border: 1.5rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* ===== Upload Area ===== */
.upload-area {
  border: 2rpx dashed var(--text-tertiary);
  border-radius: var(--radius-lg);
  padding: 72rpx 32rpx;
  text-align: center;
  background: var(--bg);
  transition: all 0.15s;
}

.upload-area:active {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.upload-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  display: block;
  margin-top: 12rpx;
}

.upload-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  display: block;
}

/* ===== Action Bar ===== */
.action-bar {
  padding: 12rpx 20rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

/* ===== Slider ===== */
.slider-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.slider-header .form-label {
  margin-bottom: 0;
}

.slider-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary);
}

/* ===== Icon Sizing ===== */
.icon-svg {
  width: 40rpx;
  height: 40rpx;
  display: block;
  flex-shrink: 0;
}

.icon-svg.sm { width: 32rpx; height: 32rpx; }
.icon-svg.lg { width: 48rpx; height: 48rpx; }
